// =============================================================================
// ArenaBeach — Prisma Schema (Fase 1)
// Banco: PostgreSQL
// Convenções:
//   - IDs em UUID
//   - Valores monetários em centavos (Int) para evitar erros de ponto flutuante
//   - Datas/horas em UTC (timestamptz)
//   - Tabelas em snake_case via @@map; campos em camelCase no código
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  PLAYER // jogador comum
  TEACHER // professor da arena (Fase de Aulas)
  ARENA_ADMIN // dono/gestor de uma arena
  SUPER_ADMIN // administrador da plataforma (SaaS)
}

/// Categorias do Beach Tennis, da menor para a maior:
/// Iniciante -> D -> C -> B -> A
enum PlayerLevel {
  INICIANTE // primeiros passos
  D // já joga partidas
  C // intermediário
  B // intermediário avançado
  A // avançado / competitivo
}

enum CourtSurface {
  SAND
  SYNTHETIC
}

enum CourtStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

/// Ciclo de vida: PENDING_PAYMENT --(paga em até 15 min)--> CONFIRMED
///                 PENDING_PAYMENT --(prazo esgotado)------> CANCELLED (automático)
///                 PENDING_PAYMENT | CONFIRMED --(usuário)--> CANCELLED
enum BookingStatus {
  PENDING_PAYMENT // aguardando pagamento (prazo em expiresAt)
  CONFIRMED // paga/confirmada
  CANCELLED // cancelada pelo usuário ou admin
  COMPLETED // partida realizada
  NO_SHOW // usuário não compareceu
}

enum BookingType {
  REGULAR // reserva comum
  OPEN_MATCH // reserva vinculada a uma partida aberta
  CLASS // aula (Fase de Aulas)
  MAINTENANCE // bloqueio administrativo
}

/// Ciclo da partida ao vivo: WAITING (sala aberta, jogadores entrando com o PIN)
/// -> IN_PROGRESS (jogo rolando) -> FINISHED (pontos distribuídos). CANCELLED: host desistiu.
enum MatchSessionStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum MatchFormat {
  SINGLES // 1x1 (2 jogadores)
  DOUBLES // 2x2 (4 jogadores)
}

enum ParticipantStatus {
  PENDING // solicitou entrada (se o host aprova manualmente)
  CONFIRMED
  DECLINED
  LEFT
}

/// Público-alvo de uma aula
enum LessonLevel {
  BEGINNER // Iniciante
  INTERMEDIATE // Intermediário
  ADVANCED // Avançado
}

enum EnrollmentStatus {
  ENROLLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum MediaType {
  PHOTO
  VIDEO
}

// -----------------------------------------------------------------------------
// USER — jogadores, professores e administradores
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(180)
  passwordHash String   @map("password_hash")
  phone        String?  @db.VarChar(20)
  /// URL pública da foto (S3/Cloudinary em produção; disco local em dev)
  profilePhoto String?  @map("avatar_url")
  bio          String?  @db.VarChar(500)
  role         UserRole @default(PLAYER)
  /// Pontuação ELO. A CATEGORIA (Iniciante, D, C, B, A) é derivada dela no
  /// código (modules/rating/categories.ts) — não é mais escolhida pelo jogador.
  eloScore     Int      @default(1000) @map("elo_score")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relações
  ownedArenas         Arena[]            @relation("ArenaOwner")
  bookings            Booking[]          @relation("BookingUser")
  hostedMatches       MatchSession[]     @relation("MatchHost")
  matchParticipations MatchParticipant[]
  uploadedMedia       Media[]            @relation("MediaUploader")
  teacherProfile      Teacher?
  recordedResults     MatchResult[]      @relation("ResultRecorder")
  lessonEnrollments   LessonEnrollment[]

  @@index([role])
  @@index([eloScore])
  @@map("users")
}

// -----------------------------------------------------------------------------
// ARENA — tenant do SaaS (uma arena possui várias quadras)
// Incluída já na Fase 1 para suportar multi-arena sem migração destrutiva.
// -----------------------------------------------------------------------------

model Arena {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.VarChar(1000)
  phone       String?  @db.VarChar(20)
  address     String   @db.VarChar(255)
  city        String   @db.VarChar(100)
  state       String   @db.Char(2)
  /// Coordenadas para a API de clima
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  timezone    String   @default("America/Sao_Paulo") @db.VarChar(64)
  isActive    Boolean  @default(true) @map("is_active")

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("ArenaOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courts       Court[]
  teachers     Teacher[]
  pricingRules PricingRule[]

  @@index([ownerId])
  @@index([city, state])
  @@map("arenas")
}

// -----------------------------------------------------------------------------
// COURT — quadras
// -----------------------------------------------------------------------------

model Court {
  id      String @id @default(uuid()) @db.Uuid
  arenaId String @map("arena_id") @db.Uuid
  arena   Arena  @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  name            String       @db.VarChar(60)
  surface         CourtSurface @default(SAND)
  isCovered       Boolean      @default(false) @map("is_covered")
  hasLighting     Boolean      @default(true) @map("has_lighting")
  status          CourtStatus  @default(ACTIVE)
  /// Preço por hora em centavos (ex.: 12000 = R$ 120,00)
  pricePerHour    Int          @map("price_per_hour")
  /// Duração padrão do slot em minutos (ex.: 60, 90)
  slotDurationMin Int          @default(60) @map("slot_duration_min")
  /// Horário de funcionamento no formato "HH:mm" (fuso da arena)
  openTime        String       @default("06:00") @map("open_time") @db.VarChar(5)
  closeTime       String       @default("23:00") @map("close_time") @db.VarChar(5)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings     Booking[]
  pricingRules PricingRule[]

  @@unique([arenaId, name])
  @@index([arenaId, status])
  @@map("courts")
}

// -----------------------------------------------------------------------------
// PRICING RULE — precificação dinâmica ("horário nobre", "fim de semana").
// Sem regra aplicável, vale o Court.pricePerHour (preço base).
// Precedência quando várias regras cobrem o mesmo horário:
//   1. regra da quadra específica vence regra da arena inteira (courtId null)
//   2. entre regras do mesmo nível, vale o MAIOR preço
// Cada slot é cobrado pela regra vigente no seu horário de INÍCIO.
// Reservas já feitas guardam o próprio totalPrice: mudar a regra não as altera.
// -----------------------------------------------------------------------------

model PricingRule {
  id      String  @id @default(uuid()) @db.Uuid
  arenaId String  @map("arena_id") @db.Uuid
  arena   Arena   @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  /// null = vale para todas as quadras da arena
  courtId String? @map("court_id") @db.Uuid
  court   Court?  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  name         String @db.VarChar(60)
  /// Dias da semana em que a regra vale: 0 = domingo ... 6 = sábado
  daysOfWeek   Int[]  @map("days_of_week") @db.SmallInt
  /// Janela no horário local da arena, "HH:mm". endTime "00:00" = meia-noite
  startTime    String @map("start_time") @db.VarChar(5)
  endTime      String @map("end_time") @db.VarChar(5)
  /// Preço por hora em centavos dentro da janela
  pricePerHour Int    @map("price_per_hour")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([arenaId])
  @@index([courtId])
  @@map("pricing_rules")
}

// -----------------------------------------------------------------------------
// BOOKING — reservas de horário (TimeSlot materializado)
// Bloqueio de manutenção = Booking com type MAINTENANCE (motivo em `notes`):
// a mesma EXCLUSION CONSTRAINT que impede reservas sobrepostas garante que
// ninguém reserve um horário bloqueado. A quadra INTEIRA fora de uso por
// tempo indeterminado usa Court.status = MAINTENANCE.
// Obs.: a prevenção de sobreposição de horários deve ser garantida com uma
// EXCLUSION CONSTRAINT no PostgreSQL (btree_gist), adicionada via migration SQL
// manual, pois o Prisma não suporta isso nativamente. Ver docs/README.
// -----------------------------------------------------------------------------

model Booking {
  id      String @id @default(uuid()) @db.Uuid
  courtId String @map("court_id") @db.Uuid
  court   Court  @relation(fields: [courtId], references: [id], onDelete: Restrict)
  userId  String @map("user_id") @db.Uuid
  user    User   @relation("BookingUser", fields: [userId], references: [id], onDelete: Restrict)

  startTime DateTime      @map("start_time") @db.Timestamptz(3)
  endTime   DateTime      @map("end_time") @db.Timestamptz(3)
  type      BookingType   @default(REGULAR)
  status    BookingStatus @default(PENDING_PAYMENT)

  /// Valor total em centavos
  totalPrice        Int           @map("total_price")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  /// ID da transação no gateway (Mercado Pago / Stripe)
  paymentExternalId String?       @map("payment_external_id")
  /// Prazo para pagar (createdAt + 15 min). Depois disso a reserva é cancelada sozinha.
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)

  notes              String?   @db.VarChar(500)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(255)
  /// Se esta reserva foi reagendada, aponta para a reserva original
  rescheduledFromId  String?   @unique @map("rescheduled_from_id") @db.Uuid
  rescheduledFrom    Booking?  @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo      Booking?  @relation("Reschedule")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  matchSession MatchSession?
  /// Quando a reserva é o bloqueio de quadra de uma aula
  lesson       Lesson?

  @@index([courtId, startTime, endTime])
  @@index([userId, startTime])
  @@index([status])
  @@index([status, expiresAt])
  @@map("bookings")
}

// -----------------------------------------------------------------------------
// MATCH SESSION — partidas abertas (matchmaking)
// Uma partida aberta sempre nasce de uma Booking (o host alugou a quadra).
// -----------------------------------------------------------------------------

model MatchSession {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @unique @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hostId    String  @map("host_id") @db.Uuid
  host      User    @relation("MatchHost", fields: [hostId], references: [id], onDelete: Restrict)

  title            String?            @db.VarChar(120)
  description      String?            @db.VarChar(500)
  format           MatchFormat        @default(DOUBLES)
  /// Total de jogadores (inclui o host). Ex.: DOUBLES = 4
  maxPlayers       Int                @default(4) @map("max_players")
  /// Faixa de nível aceita (ex.: C até B)
  minLevel         PlayerLevel?       @map("min_level")
  maxLevel         PlayerLevel?       @map("max_level")
  /// Cota individual em centavos (totalPrice / maxPlayers, calculado no service)
  pricePerPlayer   Int                @default(0) @map("price_per_player")
  /// Se true, o host precisa aprovar cada entrada
  requiresApproval Boolean            @default(false) @map("requires_approval")
  isPublic         Boolean            @default(true) @map("is_public")
  status           MatchSessionStatus @default(WAITING)

  /// PIN numérico para entrar na sala. Único entre salas ATIVAS: é zerado
  /// (null) ao encerrar/cancelar, liberando o número para outras partidas.
  pinCode    String?   @unique @map("pin_code") @db.VarChar(6)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  /// Placar/resultado (preenchido após a partida) — ex.: "6-4 / 3-6 / 10-8"
  score String? @db.VarChar(60)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants MatchParticipant[]
  media        Media[]
  /// Resultado (só existe em partidas pontuadas pelo ELO)
  result       MatchResult?

  @@index([status, isPublic])
  @@index([hostId, status])
  @@map("match_sessions")
}

/// Tabela de junção User <-> MatchSession com status e controle do split de pagamento
model MatchParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  matchSessionId String       @map("match_session_id") @db.Uuid
  matchSession   MatchSession @relation(fields: [matchSessionId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            ParticipantStatus @default(PENDING)
  /// Time na partida (1 ou 2) — opcional até o jogo começar
  team              Int?              @db.SmallInt
  amountDue         Int               @default(0) @map("amount_due")
  /// Fotografia do ELO do jogador nesta partida (null = partida não pontuada)
  eloBefore         Int?              @map("elo_before")
  eloAfter          Int?              @map("elo_after")
  eloDelta          Int?              @map("elo_delta")
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  paymentExternalId String?           @map("payment_external_id")

  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([matchSessionId, userId])
  @@index([userId])
  @@map("match_participants")
}

// -----------------------------------------------------------------------------
// MEDIA — fotos e vídeos (S3 / Cloudinary)
// -----------------------------------------------------------------------------

model Media {
  id             String        @id @default(uuid()) @db.Uuid
  uploaderId     String        @map("uploader_id") @db.Uuid
  uploader       User          @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  /// Mídia pode pertencer a uma partida (galeria da partida) ou só ao perfil
  matchSessionId String?       @map("match_session_id") @db.Uuid
  matchSession   MatchSession? @relation(fields: [matchSessionId], references: [id], onDelete: SetNull)

  type         MediaType @default(PHOTO)
  url          String
  /// Chave/ID no provedor (S3 key ou Cloudinary public_id) — usado para deletar
  storageKey   String    @map("storage_key")
  thumbnailUrl String?   @map("thumbnail_url")
  caption      String?   @db.VarChar(300)
  /// Tamanho em bytes
  sizeBytes    Int?      @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([uploaderId, createdAt])
  @@index([matchSessionId])
  @@map("media")
}

// -----------------------------------------------------------------------------
// TEACHER — professor da arena (perfil ligado a um User com role TEACHER)
// -----------------------------------------------------------------------------

model Teacher {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @unique @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  arenaId String @map("arena_id") @db.Uuid
  arena   Arena  @relation(fields: [arenaId], references: [id], onDelete: Cascade)

  bio      String?       @db.VarChar(600)
  /// Modalidades que o professor atende
  levels   LessonLevel[]
  isActive Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lessons Lesson[]

  @@index([arenaId, isActive])
  @@map("teachers")
}

// -----------------------------------------------------------------------------
// LESSON — uma ocorrência de aula. A quadra fica bloqueada por uma Booking do
// tipo CLASS (1:1), então a mesma EXCLUSION CONSTRAINT das reservas impede
// conflito entre aulas e reservas comuns. Aulas recorrentes = várias Lessons
// com o mesmo seriesId (uma por semana).
// -----------------------------------------------------------------------------

model Lesson {
  id        String  @id @default(uuid()) @db.Uuid
  teacherId String  @map("teacher_id") @db.Uuid
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  bookingId String  @unique @map("booking_id") @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Agrupa as ocorrências de uma aula recorrente (null = aula avulsa)
  seriesId  String? @map("series_id") @db.Uuid

  title           String      @db.VarChar(120)
  level           LessonLevel
  /// Vagas de alunos
  capacity        Int
  /// Valor por aluno em centavos
  pricePerStudent Int         @map("price_per_student")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollments LessonEnrollment[]

  @@index([teacherId])
  @@index([seriesId])
  @@map("lessons")
}

model LessonEnrollment {
  id       String           @id @default(uuid()) @db.Uuid
  lessonId String           @map("lesson_id") @db.Uuid
  lesson   Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String           @map("user_id") @db.Uuid
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   EnrollmentStatus @default(ENROLLED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([lessonId, userId])
  @@index([userId, status])
  @@map("lesson_enrollments")
}

// -----------------------------------------------------------------------------
// MATCH RESULT — resultado de uma partida ao vivo pontuada pelo ELO.
// Times: o número do time de cada jogador fica em MatchParticipant.team (1|2).
// -----------------------------------------------------------------------------

model MatchResult {
  id             String       @id @default(uuid()) @db.Uuid
  matchSessionId String       @unique @map("match_session_id") @db.Uuid
  matchSession   MatchSession @relation(fields: [matchSessionId], references: [id], onDelete: Cascade)

  winnerTeam     Int   @map("winner_team") @db.SmallInt
  loserTeam      Int   @map("loser_team") @db.SmallInt
  /// ELO médio de cada time no momento da partida
  team1AvgElo    Int   @map("team1_avg_elo")
  team2AvgElo    Int   @map("team2_avg_elo")
  /// Variação aplicada a cada jogador: vencedores ganham, perdedores perdem
  winnerDelta    Int   @map("winner_delta")
  loserDelta     Int   @map("loser_delta")
  /// Probabilidade (0-1) que o time vencedor tinha de ganhar — mede a zebra
  winnerExpected Float @map("winner_expected")
  kFactor        Int   @map("k_factor")

  recordedById String @map("recorded_by_id") @db.Uuid
  recordedBy   User   @relation("ResultRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("match_results")
}
