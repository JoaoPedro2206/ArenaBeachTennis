NODE_ENV=development
PORT=3333

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/arenabeach?schema=public"

# Auth (gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-este-segredo-por-um-valor-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d

# CORS — origens do frontend separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# A cada quantos ms o worker cancela reservas não pagas no prazo (opcional, padrão 30000)
BOOKING_EXPIRATION_SWEEP_MS=30000

# Proxies reversos na frente da API (Nginx, load balancer). 0 = acesso direto.
# Em producao atras de proxy, defina 1 — senao o limite de tentativas de login
# enxerga todos os usuarios com o mesmo IP.
TRUST_PROXY=0

# E-mail (recuperação de senha / verificação)
# URL pública do frontend: base dos links enviados por e-mail
APP_URL=http://localhost:5173
# "console" imprime o e-mail (com o link) no terminal; "resend" envia de verdade (obrigatório em produção)
MAIL_PROVIDER=console
MAIL_FROM="Arena Beach <nao-responda@seudominio.com>"
# Só com MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
