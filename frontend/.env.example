# URL base da API.
# Em desenvolvimento, deixe "/api/v1": o Vite faz proxy para o backend (sem CORS).
# Em produção, use a URL completa, ex.: https://api.arenabeach.com.br/api/v1
VITE_API_URL=/api/v1

# true = usa dados falsos (src/services/mocks/bookingMocks.ts), sem precisar do backend
VITE_USE_MOCKS=false
